{
  "manifest_version": 3,
  "name": "Twitch Volume Balance",
  "version": "0.2.1",
  "description": "配信者ごとの音量差を記憶し、Twitchの再生音量を自動で補正します。",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Twitch Volume Balance",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "increase-volume": {
      "suggested_key": {
        "default": "Alt+Shift+Up",
        "mac": "Command+Shift+Up"
      },
      "description": "現在のチャンネルの補正を5%上げる"
    },
    "decrease-volume": {
      "suggested_key": {
        "default": "Alt+Shift+Down",
        "mac": "Command+Shift+Down"
      },
      "description": "現在のチャンネルの補正を5%下げる"
    },
    "reset-volume": {
      "suggested_key": {
        "default": "Alt+Shift+0",
        "mac": "Command+Shift+0"
      },
      "description": "現在のチャンネルの補正を100%に戻す"
    },
    "toggle-enabled": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "音量補正の有効・無効を切り替える"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://m.twitch.tv/*",
        "https://player.twitch.tv/*"
      ],
      "js": ["content/audio-engine.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://m.twitch.tv/*",
        "https://player.twitch.tv/*"
      ],
      "js": ["lib/channel.js", "lib/storage.js", "content/bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
